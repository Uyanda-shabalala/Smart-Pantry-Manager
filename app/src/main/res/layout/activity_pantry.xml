<?xml version='1.0' encoding='utf-8'?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
    <TextView style="@style/Title" android:text="@string/pantry" />
    <TextView style="@style/Body" android:text="@string/pantry_subtitle" />
    <com.google.android.material.button.MaterialButton android:id="@+id/add" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:text="@string/add" />
    <TextView android:id="@+id/count" style="@style/Section" />
    <TextView style="@style/Body" android:text="@string/empty" android:id="@+id/empty" android:visibility="gone" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/list" android:layout_width="match_parent" android:layout_height="wrap_content" android:clipToPadding="false" android:nestedScrollingEnabled="false" />
  </LinearLayout>
</androidx.core.widget.NestedScrollView>