<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/cream">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginBottom="12dp"
            android:src="@drawable/ic_leaf"
            android:contentDescription="@null" />

        <TextView
            style="@style/Title"
            android:text="@string/pantry" />

        <TextView
            style="@style/Body"
            android:text="@string/pantry_subtitle" />

        <TextView
            android:id="@+id/expirySummary"
            style="@style/Body"
            android:background="@drawable/bg_card_mint"
            android:padding="16dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/count"
            style="@style/Section" />

        <TextView
            android:id="@+id/empty"
            style="@style/Body"
            android:text="@string/empty"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/addItem"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/sage_dark"
            android:text="@string/add_ingredient_btn"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="28dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
