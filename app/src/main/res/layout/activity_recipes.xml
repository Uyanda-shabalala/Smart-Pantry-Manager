<?xml version='1.0' encoding='utf-8'?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
    <TextView style="@style/Title" android:text="@string/recipe_title" />
    <TextView style="@style/Body" android:text="@string/recipe_subtitle" />
    <TextView style="@style/Body" android:text="@string/recipe_note" />
    <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/samples" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/sample_toggle" android:checked="true" />
    <TextView style="@style/Body" android:text="@string/empty_preview" android:id="@+id/emptyPreview" android:visibility="gone" />
    <TextView style="@style/Body" android:text="@string/no_matches" android:id="@+id/empty" android:visibility="gone" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/list" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false" />
  </LinearLayout>
</androidx.core.widget.NestedScrollView>